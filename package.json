{
  "name": "systemlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
